{
  "name": "tiktok-streak",
  "version": "2.0.0",
  "private": true,
  "description": "Auto giữ chuỗi TikTok trên GitHub Actions với người nhận cố định và chống gửi trùng.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dry-run": "node index.js --dry-run",
    "check-config": "node index.js --check-config",
    "test": "node --test test/*.test.js",
    "test:browser": "node --test test/browser.test.js"
  },
  "engines": { "node": ">=22" },
  "repository": { "type": "git", "url": "git+https://github.com/manh02847/TikTok-Streak.git" },
  "license": "MIT",
  "dependencies": { "playwright": "1.62.1" }
}
